# Nginx Container Deployment Quadlet Container Configuration
# Place this file in /etc/containers/systemd/ (system-wide) or ~/.config/containers/systemd/ (user)
# Then run: systemctl daemon-reload && systemctl start webserver.service

[Unit]
Description=Nginx Webserver Container
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Container]
Image={{ nginx_container_image }}
ContainerName={{ nginx_container_name }}

# Port mappings
PublishPort={{ nginx_host_http_port }}:{{ nginx_http_port }}
{% if  use_pki_certs is defined and use_pki_certs | bool %}
PublishPort={{ nginx_host_https_port }}:{{ nginx_https_port }}
{% endif %}

# Volume mounts
Volume={{ nginx_webserver_dir }}:{{ nginx_container_webserver_dir }}{{ append_sel }}
Volume={{ platform_container_staging_dir }}/nginx.conf:/etc/nginx/nginx.conf{{ append_sel }}
{% if  use_pki_certs is defined and use_pki_certs | bool %}
Volume={{ nginx_container_cert }}:/{{ nginx_certfile }}:z
Volume={{ nginx_container_key }}:/{{ nginx_certkeyfile }}:z
{% endif %}

# Network configuration
{% if use_webserver_network is defined and use_webserver_network | bool %}
Network=webserver-network
{% else %}
Network=host
{% endif %}

# Environment variables

# Security and resource limits
#NoNewPrivileges=yes
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
AddCapability=CHOWN
AddCapability=SETGID
AddCapability=SETUID

# Logging
LogDriver=journald

# Health check
HealthInterval=2m
HealthRetries=5
HealthStartPeriod=10s
HealthTimeout=20s

# Podman Args
PodmanArgs={{ append_rap }}

[Service]
#Restart=on-failure
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
