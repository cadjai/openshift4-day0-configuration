resource "aws_instance" "bootstrap-node" {
  ami = var.rhcos_ami
  instance_type = var.ec2_type
  subnet_id = var.subnet_list[0]
  user_data = "{\"ignition\": {\"version\": \"${var.ignition_ver}\",\"config\": {\"replace\": {\"source\": \"http://${var.webserver_hostname}:${var.webserver_port}/bootstrap.ign\",\"verification\":{}}}}}"

  iam_instance_profile = data.aws_iam_instance_profile.master-profile.name

  root_block_device { volume_size = var.volume_size }

  vpc_security_group_ids = [data.aws_security_group.master-sg.id]

  tags = merge(
  var.default_tags,
  map(
    "Name", "${var.cluster_name}-bootstrap-node",
    "kubernetes.io/cluster/${var.cluster_name}", "owned"
    )
  )
}
